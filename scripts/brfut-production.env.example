# Ambiente de produção — VPS Locaweb (copiar para /etc/brfut/brfut.env)
# Permissões: chown root:brfut && chmod 640 (User=brfut precisa ler o arquivo)

# Pasta persistente de usuários, sessões e saves na VPS
BRFUT_DATA_DIR=/var/lib/brfut/data

# Google OAuth — mesmo Client ID do Google Cloud Console
BRFUT_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com

# Origens do front que podem chamar a API (CORS)
# Separe por vírgula, sem espaços extras
BRFUT_CORS_ORIGINS=https://brfut.com.br,https://www.brfut.com.br,https://vinaogamez.github.io

# Opcional: apontar o serviço systemd para este arquivo
# BRFUT_ENV_FILE=/etc/brfut/brfut.env
