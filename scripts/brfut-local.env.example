# Copie para brfut-local.env (gitignored) e preencha o Client ID do Google Cloud.
# Tipo: OAuth 2.0 · Aplicativo da Web
BRFUT_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com

# CORS do servidor local 5081 (padrão se omitido)
# BRFUT_CORS_ORIGINS=http://127.0.0.1:5081,http://localhost:5081

# Google Cloud Console → Origens JavaScript autorizadas (obrigatório para login local):
#   http://127.0.0.1:5081
#   http://localhost:5081
